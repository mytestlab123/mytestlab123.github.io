---

<div class="portfolio-project-grid">
  {projects.map((project) => (
    <a class="portfolio-project-card" href={project.href} target="_blank" rel="noreferrer">
      <div class="portfolio-project-card__top">
        <span class="portfolio-project-card__emoji" aria-hidden="true">{project.emoji}</span>
        <span class="portfolio-project-card__arrow" aria-hidden="true">↗</span>
      </div>
      <div class="portfolio-project-card__eyebrow">{project.eyebrow}</div>
      <h3>{project.title}</h3>
      <p>{project.summary}</p>
      <div class="portfolio-project-card__tags">
        {project.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </a>
  ))}
</div>
